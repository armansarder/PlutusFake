# Documentation only: the application reads environment variables, not .env files.
# Never commit real keys. This file deliberately has no usable token or Nessie key.
FINPILOT_MODE=local
FINPILOT_DATA_SOURCE=mock
FINPILOT_ALLOWED_HOSTS=localhost,127.0.0.1
# FINPILOT_API_TOKEN=<generate at least 32 random characters locally>
# FINPILOT_CUSTOMER_ID=<customer authorized for this service>
# FINPILOT_CORS_ORIGINS=http://localhost:5173
# FINPILOT_DATA_SOURCE=nessie
# NESSIE_BASE_URL=https://prod-api.nessieisreal.com
# NESSIE_API_KEY=<server-side Nessie sandbox API key>
# NESSIE_ACCOUNT_ID=<optional owned Checking/Savings selection; required if ambiguous>
# Nessie mode reads explicit source-dated bills. Unset FINPILOT_UPCOMING_FILE;
# pipeline-inferred paychecks and rolled-forward bill dates are not used.
# FINPILOT_CURRENCY=USD
