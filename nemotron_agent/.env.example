# Copy to nemotron_agent/.env; paste only your replacement key after the equals sign.
NVIDIA_API_KEY=PASTE_REPLACEMENT_KEY_HERE
# Model alias from the NVIDIA Build Python example.
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Agent service defaults to synthetic demo data. Set engine for the integrated source.
AGENT_DATA_SOURCE=demo
# Configure these in your shell or root .env for frontend integration:
# FINPILOT_API_TOKEN=<server-side token, at least 32 characters>
# FINPILOT_CUSTOMER_ID=synthetic_demo
# FINPILOT_CORS_ORIGINS=http://localhost:5173
# FINPILOT_ALLOWED_HOSTS=localhost,127.0.0.1
# For live data, AGENT_DATA_SOURCE=engine and FINPILOT_DATA_SOURCE=nessie;
# use the existing backend Nessie/customer/schedule configuration.
