# Copy to nemotron_agent/.env; paste only your replacement key after the equals sign.
NVIDIA_API_KEY=PASTE_REPLACEMENT_KEY_HERE
# Model alias from the NVIDIA Build Python example.
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Use the selected Nessie customer for every engine and agent endpoint.
AGENT_DATA_SOURCE=nessie
FINPILOT_DATA_SOURCE=nessie
NESSIE_BASE_URL=https://prod-api.nessieisreal.com
# NESSIE_API_KEY=<server-side Nessie sandbox key>
# NESSIE_ACCOUNT_ID=<optional owned account; required when checking selection is ambiguous>
# Configure these in your shell or root .env for frontend integration:
# FINPILOT_API_TOKEN=<server-side token, at least 32 characters>
# FINPILOT_CUSTOMER_ID=synthetic_demo
# FINPILOT_CORS_ORIGINS=http://localhost:5173
# FINPILOT_ALLOWED_HOSTS=localhost,127.0.0.1
# Unset FINPILOT_UPCOMING_FILE; only explicit future Nessie bill dates are used.
# To intentionally run the old $800 fixture instead, select AGENT_DATA_SOURCE=demo
# and unset FINPILOT_DATA_SOURCE. Never use that as a Nessie error fallback.
